# Google Sheets API read-only audit settings.
# Copy to .env locally if needed, but never commit .env or real credentials.

# Spreadsheet ID for AS-HR-ZOOM-MVP_Form1_Calendar_Zoom.
GOOGLE_SHEETS_SPREADSHEET_ID=1CpnuS8MxiEGTNWSaKsTWQqw6HuBIRScntDGjPkw5HCI

# Preferred for automation: service account JSON stored outside the repo,
# or in a local ignored credentials/ folder.
GOOGLE_SHEETS_SERVICE_ACCOUNT_FILE=C:\path\outside\repo\academy-strateg-sheets-readonly.json

# Optional report output directory.
GOOGLE_SHEETS_AUDIT_REPORT_DIR=reports/google_sheets_audit
